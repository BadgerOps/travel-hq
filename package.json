{
  "name": "travel-hq",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:client": "vitest run -c vitest.client.config.ts",
    "test:all": "npm test && npx vitest run -c vitest.arch.config.ts && npm run test:client",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "predeploy:testing": "npm run build",
    "deploy:testing": "wrangler deploy --env testing",
    "predeploy:production": "npm run build",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^4.4.1",
    "hono": "^4.12.31",
    "jose": "^6.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.1",
    "vite": "^6.0.5",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@fontsource/inter": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
